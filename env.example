# --- Server ---
PORT=4000
NODE_ENV=production
# Comma-separated list of origins allowed to call this API (your hosted frontend URL)
# For production: CORS_ORIGIN=https://munshi-frontend-gilt.vercel.app
# For local dev: CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=https://munshi-frontend-gilt.vercel.app,http://localhost:3000

# --- Database (Postgres — Railway/Supabase/Render all work) ---
DATABASE_URL=postgres://user:password@host:5432/munshi

# --- Auth ---
# Random long string — used to sign login JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- WooCommerce (zairascollection.com) ---
WC_STORE_URL=https://zairascollection.com
# WordPress Admin -> WooCommerce -> Settings -> Advanced -> REST API -> Add key (Read/Write)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WooCommerce -> Settings -> Advanced -> Webhooks -> Add webhook -> Secret
# Used to verify that incoming webhook calls really came from WooCommerce
WC_WEBHOOK_SECRET=change-me-webhook-secret

# One-time backfill: how many past days of orders to pull in on first sync/poll fallback
WC_BACKFILL_DAYS=30

# --- First owner login (optional, one-time) ---
# If set, the app automatically creates this login the first time it starts
# up against an empty database — useful when you can't run an interactive
# console command. Safe to leave in afterwards; it only runs if no users
# exist yet. Feel free to remove these three lines once you've logged in.
OWNER_NAME=Zaira
OWNER_EMAIL=owner@zairascollection.com
OWNER_PASSWORD=change-me-strong-password

# --- YITH WooCommerce Affiliates sync (optional) ---
# YITH has no public REST API, so this points at a small custom endpoint
# added to the WordPress site itself — see
# wordpress-snippets/munshi-yith-bridge.php in this project for the code
# and setup steps. Leave blank to skip affiliate syncing entirely.
YITH_SYNC_URL=https://zairascollection.com/wp-json/munshi/v1/affiliates
YITH_SYNC_SECRET=change-me-yith-bridge-secret

# --- Low stock alerts via Twilio (optional) ---
# Leave blank to skip. Works with plain SMS or WhatsApp (set TWILIO_WHATSAPP=true
# and make sure your Twilio number is WhatsApp-enabled, e.g. the Twilio sandbox).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006
TWILIO_WHATSAPP=false
ALERT_TO_NUMBER=+92XXXXXXXXXX
# Random secret for the unauthenticated /alerts/low-stock/cron endpoint,
# used by a Railway Cron Job service to trigger a daily check automatically.
ALERTS_CRON_SECRET=change-me-cron-secret
