          "type": "string",
          "format": "uuid"
         },
         "delta": {
          "type": "integer",
          "description": "+5 ya -2"
         },
         "reason": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Ho gaya"
     },
     "400": {
      "description": "Data galat ya stock kam"
     },
     "403": {
      "description": "Writes band (AGENT_API_WRITE)"
     },
     "422": {
      "description": "Idempotency-Key kisi aur request ki"
