     "200": {
      "description": "OK"
     },
     "401": {
      "description": "Galat key"
     }
    }
   }
  },
  "/sale": {
   "post": {
    "summary": "Nayi sale/bill likho",
    "description": "Stock ghatata hai, paid raqam account mein jorta hai, website stock push karta hai. Stock kam ho to 400.",
    "parameters": [
     {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "description": "Har naye kaam ke liye nayi random key (8-100 chars). Wohi key dobara bhejne par dobara entry NAHI banti.",
      "schema": {
       "type": "string",
       "minLength": 8,
       "maxLength": 100
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "customer",
         "items",
         "status"
        ],
        "properties": {
         "customer": {
          "type": "string"
         },
         "phone": {
          "type": "string"
         },
         "city": {
          "type": "string"
         },
         "items": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "object",
           "required": [
            "inventory_id",
            "qty"
           ],
           "properties": {
            "inventory_id": {
             "type": "string",
             "format": "uuid"
            },
            "qty": {
             "type": "integer",
             "minimum": 1
            },
            "price": {
             "type": "number",
             "description": "Na do to inventory ki price"
            }
           }
          }
         },
         "status": {
          "type": "string",
          "enum": [
           "Pending",
           "Shipped",
           "Delivered"
          ]
         },
         "amount_paid": {
          "type": "number",
          "default": 0
         },
         "account_id": {
          "type": "string",
          "format": "uuid",
          "description": "amount_paid > 0 ho to lazmi"
         },
         "method": {
          "type": "string"
         },
         "due_date": {
          "type": "string",
          "format": "date"
         },
         "channel": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Ho gaya"
     },
     "400": {
      "description": "Data galat ya stock kam"
     },
     "403": {
      "description": "Writes band (AGENT_API_WRITE)"
     },
     "422": {
      "description": "Idempotency-Key kisi aur request ki"
     }
    }
   }
  },
  "/payment": {
   "post": {
    "summary": "Udhaar ki wasooli likho",
    "description": "Order ka baqaya kam karta hai, account balance barhata hai. Baqaye se zyada nahi le sakte.",
    "parameters": [
     {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "description": "Har naye kaam ke liye nayi random key (8-100 chars). Wohi key dobara bhejne par dobara entry NAHI banti.",
      "schema": {
       "type": "string",
       "minLength": 8,
       "maxLength": 100
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "order_id",
         "amount",
         "account_id"
        ],
        "properties": {
         "order_id": {
          "type": "string",
          "format": "uuid"
         },
         "amount": {
          "type": "number"
         },
         "account_id": {
          "type": "string",
          "format": "uuid"
         },
         "method": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "note": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Ho gaya"
     },
     "400": {
      "description": "Data galat ya stock kam"
     },
     "403": {
      "description": "Writes band (AGENT_API_WRITE)"
     },
     "422": {
      "description": "Idempotency-Key kisi aur request ki"
     }
    }
   }
  },
  "/stock-adjust": {
   "post": {
    "summary": "Stock theek karo (+/-)",
    "description": "Wajah (reason) lazmi. Stock manfi nahi ho sakta.",
    "parameters": [
     {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "description": "Har naye kaam ke liye nayi random key (8-100 chars). Wohi key dobara bhejne par dobara entry NAHI banti.",
